{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "House vocabulary (repo config, not part of the published spec)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["use", "for", "not"],
    "properties": {
      "use": { "type": "string", "minLength": 1 },
      "for": { "type": "string", "minLength": 1 },
      "not": { "type": "string", "minLength": 1 },
      "where": { "type": "string", "minLength": 1 }
    }
  }
}
